# Application Port
PORT=3000

# SQLite Database File Path
SQLITE_DB_PATH=./data/app.db

# Admin Credentials
ADMIN_USERNAME=admin
# Generate hash with: node scripts/hash-password.mjs <your-password>
ADMIN_PASSWORD_HASH=490fa53ee18bc825940bd4f0fbd18a29:a9f571813f639e182de57cf0731b1eaac868c92ec6c39468519df3cc03e86e64a90a05f325b40e8398cf582bb37ba9400453048a06df27aa1865a8fa65750010

# Session Secret (used for signing admin session cookies)
SESSION_SECRET=javadrill-production-secure-session-key-change-me

# Java Execution Engine Configuration
EXECUTION_TIMEOUT_MS=3000
COMPILE_TIMEOUT_MS=5000
MAX_CONCURRENT_RUNS=3
